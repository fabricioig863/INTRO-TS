{
  "compilerOptions": {
    "moduleDetection": "force", // Obriga o TypeScript a tratar o arquivo como um módulo, independentemente de ter imports ou exports
    "noImplicitAny": true, // Impede o uso de "any" implícito, obrigando a definição explícita de tipos
    "noImplicitReturns": true, // Garante que todas as funções tenham um retorno explícito e não terminem sem retornar um valor
    "strictNullChecks": true // Faz com que o TypeScript considere `null` e `undefined` como tipos distintos, evitando acessos inseguros a valores potencialmente nulos
  }
}